<https://hdl.handle.net/21.12113/516b0a833c54473689b976dfa706be01>
        a                           rico:RecordSet;
        za:parent                   <https://hdl.handle.net/21.12113/58b889ff95d84f3ebaf6827c309489d4>;
        za:top                      <https://hdl.handle.net/21.12113/4f5881e065774c7992bd266c6036c1b2>;
        rico:generalDescription     [ rico:hasTitle  [ rico:hasOrHadDescription
                                                        "L.L.J. Siegers werd geboren te Namlea op het eiland Buru op 28 september 1920. Bevat foto&apos;s van zijn jeugd op Ambon, zijn militaire diensttijd, en krijgsgevangenschap in Indië, Singapore en Japan (1942-1945) de reis naar en het verblijf in Nederland. Een selectie van 14 foto&apos;s is gedigitaliseerd. De originele foto&apos;s, opgenomen in twee albums, bevinden zich bij L.L.J. Siegers te Vlissingen (2004)"@nl ];
                                      rico:hasTitle  [ a                  rico:Title;
                                                       rico:textualValue  "Reproducties van een selectie van foto&apos;s van L.L.J. Siegers, voormalig militair van het Koninklijk Nederlands Indisch Leger (KNIL) die in 1951 naar Zeeland kwam en ondermeer werkte bij de Koninklijke Maatschappij De Schelde te Vlissingen, met fotokopieën van archiefstukken"@nl
